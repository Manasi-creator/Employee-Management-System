# MySQL connection. Create this database before starting the backend.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-your-local-database-password
DB_NAME=ems_db

# Generate a unique secret (at least 32 random bytes) and never commit it.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Do not leave this placeholder value in use.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ENV=development
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Optional: set DATABASE_URL to override the MySQL settings above.
# For local SQLite development, uncomment this and comment out MySQL settings.
# DATABASE_URL=sqlite:///./ems.db

# Local development only: required to seed demo accounts
EMS_SEED_INITIAL_PASSWORD=replace_with_a_unique_password_of_at_least_12_characters